@prefix ex: <http://example.org/edge#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Agenda #1 fixture: incomplete math/english score pairs.
# Example: alice+bob have math [0,1] and no english.

ex:alice a ex:Student ; rdfs:label "alice" ; ex:math 0 .
ex:bob   a ex:Student ; rdfs:label "bob"   ; ex:math 1 .
ex:noah  a ex:Student ; rdfs:label "noah"  ; ex:math 5 .

ex:cara a ex:Student ; rdfs:label "cara" ; ex:math 2 ; ex:english 4 .
ex:dan  a ex:Student ; rdfs:label "dan"  ; ex:math 3 ; ex:english 6 .
ex:ella a ex:Student ; rdfs:label "ella" ; ex:math 4 ; ex:english 8 .
ex:finn a ex:Student ; rdfs:label "finn" ; ex:math 10 ; ex:english 20 .

ex:eve  a ex:Student ; rdfs:label "eve"  ; ex:english 9 .
ex:gina a ex:Student ; rdfs:label "gina" ; ex:english 1 .

ex:hank a ex:Student ; rdfs:label "hank" .

ex:iris a ex:Student ; rdfs:label "iris" ; ex:math 7 ; ex:english 0 .
ex:jake a ex:Student ; rdfs:label "jake" ; ex:math 8 ; ex:english 3 .
